<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="120dp"
    android:height="120dp"
    android:viewportWidth="120"
    android:viewportHeight="120">

    <!-- Outer Rounded Glow Shield -->
    <path
        android:pathData="M24,12 L96,12 A12,12 0 0,1 108,24 L108,96 A12,12 0 0,1 96,108 L24,108 A12,12 0 0,1 12,96 L12,24 A12,12 0 0,1 24,12 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="12"
                android:startY="12"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#1A2639" android:offset="0.0" />
                <item android:color="#0B1325" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Glowing Border Frame -->
    <path
        android:pathData="M24,12 L96,12 A12,12 0 0,1 108,24 L108,96 A12,12 0 0,1 96,108 L24,108 A12,12 0 0,1 12,96 L12,24 A12,12 0 0,1 24,12 Z"
        android:strokeWidth="2">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="12"
                android:startY="12"
                android:endX="108"
                android:endY="108"
                android:type="linear">
                <item android:color="#7C4DFF" android:offset="0.0" />
                <item android:color="#00E676" android:offset="0.5" />
                <item android:color="#6C5CE7" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Main FinNova "F" Emblem Curve 1 (Top Bar) -->
    <path
        android:pathData="M36,36 L84,36 C88.4,36 92,39.6 92,44 C92,48.4 88.4,52 84,52 L52,52 L52,88 C52,92.4 48.4,96 44,96 C39.6,96 36,92.4 36,88 L36,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="36"
                android:startY="36"
                android:endX="92"
                android:endY="96"
                android:type="linear">
                <item android:color="#7C4DFF" android:offset="0.0" />
                <item android:color="#651FFF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- FinNova "F" Emblem Curve 2 (Middle Bar + Growth Arrow) -->
    <path
        android:pathData="M52,60 L76,60 C80.4,60 84,63.6 84,68 C84,72.4 80.4,76 76,76 L52,76 L52,60 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="52"
                android:startY="60"
                android:endX="84"
                android:endY="76"
                android:type="linear">
                <item android:color="#00E676" android:offset="0.0" />
                <item android:color="#00B0FF" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Diamond Accent Spark (Innovation Icon) -->
    <path
        android:pathData="M88,28 L92,36 L88,44 L84,36 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="84"
                android:startY="28"
                android:endX="92"
                android:endY="44"
                android:type="linear">
                <item android:color="#FFD700" android:offset="0.0" />
                <item android:color="#FFAB00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
