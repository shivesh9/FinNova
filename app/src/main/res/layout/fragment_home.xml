<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:paddingBottom="32dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical"><TextView android:id="@+id/demo" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="FINNOVA • DEMO MODE" android:textColor="@color/violet" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/greeting" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Good evening" android:textColor="@color/ink" android:textSize="25sp" android:textStyle="bold"/></LinearLayout>
            <com.google.android.material.card.MaterialCardView android:layout_width="42dp" android:layout_height="42dp" app:cardBackgroundColor="@color/lavender" app:cardCornerRadius="21dp"><TextView android:id="@+id/userAvatar" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="SV" android:textColor="@color/violet" android:textStyle="bold"/></com.google.android.material.card.MaterialCardView>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/navy" app:cardCornerRadius="24dp" app:cardElevation="2dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="TOTAL BALANCE" android:textColor="#BFD5EB" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/eye" android:layout_width="wrap_content" android:layout_height="wrap_content" android:contentDescription="Show or hide balances" android:padding="5dp" android:text="◉" android:textColor="@color/white" android:textSize="18sp"/></LinearLayout><TextView android:id="@+id/total" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:text="₹245,680.00" android:textColor="@color/white" android:textSize="31sp" android:textStyle="bold"/><TextView android:id="@+id/balanceSubtitle" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:text="≈ $2,940.22 USD   •   Updated just now" android:textColor="#BFD5EB"/><View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="18dp" android:background="#315675"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="✓ Your data is stored securely on this device" android:textColor="#D1E5F9" android:textSize="13sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="Quick actions" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center" android:orientation="horizontal">
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><com.google.android.material.card.MaterialCardView android:id="@+id/send" android:layout_width="58dp" android:layout_height="58dp" app:cardBackgroundColor="@color/lavender" app:cardCornerRadius="18dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="↑" android:textColor="@color/violet" android:textSize="28sp"/></com.google.android.material.card.MaterialCardView><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Send" android:textColor="@color/ink"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><com.google.android.material.card.MaterialCardView android:id="@+id/addFunds" android:layout_width="58dp" android:layout_height="58dp" app:cardBackgroundColor="@color/mint" app:cardCornerRadius="18dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="+" android:textColor="@color/success" android:textSize="28sp"/></com.google.android.material.card.MaterialCardView><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Add money" android:textColor="@color/ink"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><com.google.android.material.card.MaterialCardView android:id="@+id/convertAction" android:layout_width="58dp" android:layout_height="58dp" app:cardBackgroundColor="@color/soft_blue" app:cardCornerRadius="18dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="⇄" android:textColor="@color/navy_2" android:textSize="25sp"/></com.google.android.material.card.MaterialCardView><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Convert" android:textColor="@color/ink"/></LinearLayout>
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:gravity="center" android:orientation="vertical"><com.google.android.material.card.MaterialCardView android:id="@+id/receive" android:layout_width="58dp" android:layout_height="58dp" app:cardBackgroundColor="#FFF4DE" app:cardCornerRadius="18dp"><TextView android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:text="↓" android:textColor="#AD6B00" android:textSize="28sp"/></com.google.android.material.card.MaterialCardView><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="Receive" android:textColor="@color/ink"/></LinearLayout>
        </LinearLayout>
        <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="18dp" app:strokeColor="@color/line" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="18dp"><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Your balances" android:textColor="@color/ink" android:textSize="18sp" android:textStyle="bold"/><TextView android:id="@+id/balances" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="11dp" android:lineSpacingExtra="9dp" android:textColor="@color/ink" android:textSize="16sp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" android:gravity="center_vertical"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Recent activity" android:textColor="@color/ink" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="View all" android:textColor="@color/violet" android:textStyle="bold"/></LinearLayout><TextView android:id="@+id/recent" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:lineSpacingExtra="12dp" android:textColor="@color/ink" android:textSize="16sp"/>
    </LinearLayout>
</ScrollView>
