<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true"><LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="20dp"><TextView android:id="@+id/eyebrow" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="@color/violet" android:textSize="12sp" android:textStyle="bold"/><TextView android:id="@+id/title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:textColor="@color/ink" android:textSize="28sp" android:textStyle="bold"/><TextView android:id="@+id/subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/muted" android:textSize="16sp"/>
<com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="26dp" app:cardBackgroundColor="@color/white" app:cardCornerRadius="22dp" app:strokeColor="@color/line" app:strokeWidth="1dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp"><com.google.android.material.textfield.TextInputLayout android:id="@+id/recipientLayout" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Recipient"><com.google.android.material.textfield.TextInputEditText android:id="@+id/recipient" android:layout_width="match_parent" android:layout_height="wrap_content" android:singleLine="true"/></com.google.android.material.textfield.TextInputLayout><com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:hint="Amount in INR"><com.google.android.material.textfield.TextInputEditText android:id="@+id/amount" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="numberDecimal" android:text="1000" android:textSize="26sp" android:textStyle="bold"/></com.google.android.material.textfield.TextInputLayout><TextView android:id="@+id/info" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="17dp" android:textColor="@color/muted" android:lineSpacingExtra="4dp"/></LinearLayout></com.google.android.material.card.MaterialCardView>
<com.google.android.material.button.MaterialButton android:id="@+id/continueButton" android:layout_width="match_parent" android:layout_height="56dp" android:layout_marginTop="24dp" android:text="Continue" app:cornerRadius="16dp"/><TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="15dp" android:gravity="center" android:text="Demo only — no real money is sent or received." android:textColor="@color/muted" android:textSize="12sp"/></LinearLayout></ScrollView>
